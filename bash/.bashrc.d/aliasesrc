alias ll='ls --all'

# WSL2
alias open='explorer.exe'
alias winhome='cd /mnt/c/Users/$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d "\r")'
alias pbcopy='clip.exe'
alias pbpaste='powershell.exe Get-Clipboard'

# Neovim
alias v='nvim'
alias nv='nvim'

# Git
alias ga='git add'
alias gd='git diff'
alias gst='git status'
alias gpl='git pull'
